---
// Simple line illustrations used on cards and article pages.
interface Props {
  name: "iac" | "kubernetes" | "gitops" | "drop" | "hex" | "tablet";
  class?: string;
}

const { name, class: className } = Astro.props;
const square = name === "iac" || name === "kubernetes" || name === "gitops";
---

<svg
  class:list={["illustration", className]}
  viewBox={square ? "0 0 120 110" : "0 0 120 100"}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "iac" && (
    <>
      <rect class="paper" x="14" y="14" width="40" height="28" rx="5" />
      <rect class="paper" x="66" y="14" width="40" height="28" rx="5" />
      <rect class="sun" x="40" y="66" width="40" height="28" rx="5" />
      <path d="M34 42v10h52V42M60 52v14" />
    </>
  )}
  {name === "kubernetes" && (
    <>
      <circle class="paper" cx="60" cy="55" r="36" />
      <circle class="sun" cx="60" cy="55" r="10" />
      <path d="M60 19v26M60 65v26M24 55h26M70 55h26M35 30l18 18M67 62l18 18M85 30L67 48M53 62L35 80" />
    </>
  )}
  {name === "gitops" && (
    <>
      <path d="M20 80V30M20 50c0-14 30-14 30-28M66 55h22M82 48l7 7-7 7" />
      <circle class="paper" cx="20" cy="86" r="7" />
      <circle class="paper" cx="20" cy="24" r="7" />
      <circle class="sun" cx="50" cy="18" r="7" />
      <rect class="paper" x="92" y="38" width="20" height="34" rx="5" />
    </>
  )}
  {name === "drop" && (
    <>
      <path class="paper" d="M60 14c18 22 26 36 26 50a26 26 0 0 1-52 0c0-14 8-28 26-50z" />
      <path d="M48 66c2 8 8 12 14 12" />
    </>
  )}
  {name === "hex" && (
    <>
      <path class="paper" d="M60 12l38 22v32L60 88 22 66V34z" />
      <circle class="sun" cx="60" cy="50" r="10" />
    </>
  )}
  {name === "tablet" && (
    <>
      <rect class="paper" x="30" y="14" width="60" height="74" rx="8" />
      <path d="M44 34h32M44 46h32M44 58h20" />
      <circle cx="60" cy="78" r="2.5" fill="currentColor" />
    </>
  )}
</svg>

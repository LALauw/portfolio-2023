---
import site from "../data/site.json";
---

<header class="wrap site-header">
  <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
    <span class="monogram" aria-hidden="true">{site.initials}</span>{site.name}
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    <a class="nav-link" href="/#work">Work</a>
    <a class="nav-link" href="/#writing">Writing</a>
    <a class="nav-link" href="/cv/">CV</a>
    <a class="btn btn-dark btn-small" href={`mailto:${site.email}`}>Contact</a>
  </nav>
</header>

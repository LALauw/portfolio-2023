---
import site from "../data/site.json";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <h2>{site.footer.title}</h2>
    <p>{site.footer.text}</p>
    <div class="actions">
      <a class="btn btn-dark" href={`mailto:${site.email}`}>Email me</a>
      {site.socials.map((social) => (
        <a class="btn btn-line" href={social.url} target="_blank" rel="noreferrer">{social.label}</a>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name} · This site and the CV are generated from a handful of JSON files.</span>
      <span class="footer-links">
        <a href="/cv/">CV</a>
        <a href={site.sourceUrl} target="_blank" rel="noreferrer">Source</a>
      </span>
    </div>
  </div>
</footer>

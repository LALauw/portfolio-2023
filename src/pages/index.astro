---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Illustration from "../components/Illustration.astro";
import site from "../data/site.json";
import experience from "../data/experience.json";
import skills from "../data/skills.json";
import { city, emphasis, formatPeriod, formatYears, groupBySlug } from "../lib/format.mjs";

const articles = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const companies = groupBySlug(experience);
const current = companies.filter((company) => !company.earlier);
const earlier = companies.filter((company) => company.earlier);
const articleDate = (date: string) => new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric" }).format(new Date(date));
---

<BaseLayout>
  <section class="wrap hero">
    <h1 set:html={emphasis(site.headline)} />
    <p class="lede" set:html={emphasis(site.intro, '<span class="underline">', "</span>")} />
    <div class="actions">
      <a class="btn btn-dark" href="/cv/">Read my CV <span aria-hidden="true">→</span></a>
      <a class="btn btn-line" href={`mailto:${site.email}`}>Get in touch</a>
    </div>
  </section>

  <section class="block" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>{site.focus.title}</h2>
        <p>{site.focus.intro}</p>
      </div>
      <div class="cards">
        {site.focus.items.map((item) => (
          <article class={`card bg-${item.color}`}>
            <Illustration name={item.icon as "iac" | "kubernetes" | "gitops"} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="experience">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
        <p>{site.experienceIntro}</p>
      </div>
      <ol class="experience">
        {current.map((company) => (
          <li>
            <div class="experience-when">{formatYears(company.roles)}</div>
            <div>
              <h3><a href={company.link} target="_blank" rel="noreferrer">{company.company}</a></h3>
              {company.roles.length === 1 ? (
                <>
                  <p class="experience-role">{company.roles[0].title} · {city(company.location)}</p>
                  <p class="experience-summary">{company.roles[0].summary}</p>
                </>
              ) : (
                <>
                  <ul class="roles">
                    {company.roles.map((role) => (
                      <li><strong>{role.title}</strong><span>{formatPeriod(role.start, role.end)}</span></li>
                    ))}
                  </ul>
                  <details>
                    <summary>What I do there</summary>
                    {company.roles.map((role) => (
                      <div class="details-role">
                        <h4>{role.title}</h4>
                        <ul>{role.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
                      </div>
                    ))}
                  </details>
                </>
              )}
            </div>
          </li>
        ))}
      </ol>
      {earlier.map((company) => (
        <p class="earlier">
          Earlier: {company.roles[0].title.toLowerCase()} at {company.company} ({formatYears(company.roles)}), {company.roles[0].summary}.
        </p>
      ))}
    </div>
  </section>

  <section class="block" id="writing">
    <div class="wrap">
      <div class="section-head">
        <h2>Writing</h2>
        <p>{site.writingIntro}</p>
      </div>
      <div class="posts">
        {articles.map((article) => (
          <a class="post" href={`/work/${article.id}/`}>
            <div class={`post-thumb bg-${article.data.color}`}><Illustration name={article.data.icon} /></div>
            <div class="post-text">
              <p class="post-meta">{articleDate(article.data.date)} · {article.data.context}</p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head"><h2>Toolbox</h2></div>
      <div class="tools">
        {skills.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <p>{group.items.join(", ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

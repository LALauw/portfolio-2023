---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Illustration from "../../components/Illustration.astro";
import site from "../../data/site.json";

export async function getStaticPaths() {
  const articles = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: { article, next: articles[(index + 1) % articles.length] },
  }));
}

interface Props {
  article: CollectionEntry<"work">;
  next: CollectionEntry<"work">;
}

const { article, next } = Astro.props;
const { Content } = await render(article);
const published = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" }).format(new Date(article.data.date));
---

<BaseLayout title={`${article.data.title} - ${site.name}`} description={article.data.summary}>
  <article class="wrap">
    <header class="article-head">
      <a class="back-link" href="/#writing">← All writing</a>
      <p class="article-meta">{published} · {article.data.context}</p>
      <h1>{article.data.title}</h1>
      <p class="article-dek">{article.data.summary}</p>
    </header>

    <div class={`article-hero bg-${article.data.color}`}><Illustration name={article.data.icon} /></div>

    <dl class="facts">
      <div><dt>Role</dt><dd>{article.data.role}</dd></div>
      <div><dt>Where</dt><dd>{article.data.context}</dd></div>
      <div><dt>Stack</dt><dd>{article.data.stack.join(", ")}</dd></div>
    </dl>

    <div class="prose">
      <Content />
    </div>

    {next.id !== article.id && (
      <a class="next-article" href={`/work/${next.id}/`}>
        <span>Next article</span>
        <strong>{next.data.title} →</strong>
      </a>
    )}
  </article>
</BaseLayout>
